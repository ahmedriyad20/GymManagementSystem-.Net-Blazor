@code {
    private bool loading = true;
    private bool isFemaleOnly;

    private int totalTraineesCount;
    private int activeTraineesCount;
    private decimal monthlyEarnings;
    private decimal monthlyEarningsBeforeExpenses;
    private decimal monthOverMonthGrowth;
    private int expiringCount;
    private int debtorsCount;
    private decimal totalDebt;

    private List<GetAllTraineesResult> recentTrainees = [];
    private List<ExpiringSubscriptionResult> expiringSubList = [];
    private List<GetAllTraineesResult> allTrainees = [];
    private List<RecentFinancialTransactionResult> recentTransactions = [];

    // Search and Profile properties
    private string userName = "المشرف";
    private string userRole = "مدير النظام";
    private string searchQuery = string.Empty;
    private List<GetAllTraineesResult> searchResults = [];

    // SVG and Distribution variables
    private double activeRatio;
    private int activePercentage;
    private double strokeDashoffset;
    private int maleCount;
    private int femaleCount;
    private int malePercentage;
    private int femalePercentage;

    // Packages variables
    private int dailyCount;
    private int monthlyCount;
    private int sixMonthsCount;
    private int yearlyCount;
    private int otherCount;
    private int maxPeriodCount;

    private string activeTab = "transactions";

    protected override async Task OnInitializedAsync()
    {
        var state = await AuthStateProvider.GetAuthenticationStateAsync();
        if (state.User.Identity?.IsAuthenticated != true)
        {
            Navigation.NavigateTo("/login", true);
            return;
        }

        var claims = state.User.Claims.Select(c => c.Value.ToLowerInvariant()).ToList();
        isFemaleOnly = claims.Any(v => v.Contains("female") || v.Contains("women") || v.Contains("ladies") || v.Contains("انث"));

        // Extract user data from Claims
        var nameClaim = state.User.FindFirst(System.Security.Claims.ClaimTypes.Name) ?? 
                        state.User.FindFirst("name") ?? 
                        state.User.FindFirst("unique_name");
        userName = nameClaim?.Value ?? "المشرف";

        var roleClaims = state.User.FindAll(System.Security.Claims.ClaimTypes.Role).Select(c => c.Value).ToList();
        if (roleClaims.Contains("Administrator"))
        {
            userRole = "مدير عام النظام";
        }
        else
        {
            userRole = roleClaims.FirstOrDefault() ?? "مشرف النظام";
        }

        if (isFemaleOnly)
        {
            userRole = "مشرفة الصالة النسائية";
            activeTab = "trainees"; // default tab for female admin
        }

        await LoadDataAsync();
    }

    private async Task LoadDataAsync()
    {
        loading = true;
        try
        {
            // 1. Fetch Trainees
            enGender? filterGender = isFemaleOnly ? enGender.Female : null;
            var trainees = await ApiClient.GetTraineesAsync(null, filterGender);
            allTrainees = trainees ?? [];
            
            totalTraineesCount = allTrainees.Count;
            activeTraineesCount = allTrainees.Count(IsTraineeActive);
            recentTrainees = allTrainees.OrderByDescending(x => x.CreationTime).Take(5).ToList();

            // Circular progress ring calculation
            activeRatio = totalTraineesCount > 0 ? (double)activeTraineesCount / totalTraineesCount : 0;
            activePercentage = (int)(activeRatio * 100);
            strokeDashoffset = 314.16 - (314.16 * activeRatio);

            // Gender breakdown (general only)
            if (!isFemaleOnly)
            {
                maleCount = allTrainees.Count(t => t.Gender.Contains("Male", StringComparison.OrdinalIgnoreCase) || t.Gender == "1");
                femaleCount = allTrainees.Count(t => t.Gender.Contains("Female", StringComparison.OrdinalIgnoreCase) || t.Gender == "2");
                
                var totalWithGender = maleCount + femaleCount;
                if (totalWithGender == 0) totalWithGender = totalTraineesCount;
                
                malePercentage = totalWithGender > 0 ? (int)((double)maleCount / totalWithGender * 100) : 0;
                femalePercentage = totalWithGender > 0 ? (int)((double)femaleCount / totalWithGender * 100) : 0;
            }

            // Popular Packages calculation
            dailyCount = allTrainees.Count(t => t.CurrentSubscriptionPeriod == "Daily" || t.CurrentSubscriptionPeriod == "يومي");
            monthlyCount = allTrainees.Count(t => t.CurrentSubscriptionPeriod == "Monthly" || t.CurrentSubscriptionPeriod == "شهري");
            sixMonthsCount = allTrainees.Count(t => t.CurrentSubscriptionPeriod == "SixMonths" || t.CurrentSubscriptionPeriod == "نصف سنوي");
            yearlyCount = allTrainees.Count(t => t.CurrentSubscriptionPeriod == "Yearly" || t.CurrentSubscriptionPeriod == "سنوي");
            otherCount = allTrainees.Count(t => string.IsNullOrEmpty(t.CurrentSubscriptionPeriod) || 
                (t.CurrentSubscriptionPeriod != "Daily" && t.CurrentSubscriptionPeriod != "Monthly" && 
                 t.CurrentSubscriptionPeriod != "SixMonths" && t.CurrentSubscriptionPeriod != "Yearly" &&
                 t.CurrentSubscriptionPeriod != "يومي" && t.CurrentSubscriptionPeriod != "شهري" && 
                 t.CurrentSubscriptionPeriod != "نصف سنوي" && t.CurrentSubscriptionPeriod != "سنوي"));

            maxPeriodCount = Math.Max(1, Math.Max(dailyCount, Math.Max(monthlyCount, Math.Max(sixMonthsCount, Math.Max(yearlyCount, otherCount)))));

            // 2. Fetch Debt details from unpaid reports
            var unpaidList = await ApiClient.GetUnpaidInstallmentsAsync();
            if (isFemaleOnly)
            {
                // Female scope debtors only
                var femaleTraineeIds = allTrainees.Select(t => t.TraineeId).ToHashSet();
                var femaleUnpaid = unpaidList.Where(x => femaleTraineeIds.Contains(x.TraineeId)).ToList();
                debtorsCount = femaleUnpaid.Count;
                totalDebt = femaleUnpaid.Sum(x => x.RemainingAmount);
            }
            else
            {
                debtorsCount = unpaidList.Count;
                totalDebt = unpaidList.Sum(x => x.RemainingAmount);
            }

            // 3. Fetch Expiring lists
            var rawExpiringList = await ApiClient.GetExpiringSubscriptionsByDaysAsync(7);
            if (isFemaleOnly)
            {
                var femaleTraineeIds = allTrainees.Select(t => t.TraineeId).ToHashSet();
                expiringSubList = rawExpiringList.Where(x => femaleTraineeIds.Contains(x.TraineeId)).ToList();
            }
            else
            {
                expiringSubList = rawExpiringList;
            }
            expiringCount = expiringSubList.Count;

            // 4. Fetch Monthly earnings (Male/Full admins only)
            if (!isFemaleOnly)
            {
                var now = DateTime.Now;
                var dashboard = await ApiClient.GetEarningsDashboardAsync(now.Year, now.Month);
                if (dashboard is not null)
                {
                    monthlyEarnings = dashboard.MonthlyEarnings;
                    monthlyEarningsBeforeExpenses = dashboard.MonthlyEarningsBeforeExpenses;
                    monthOverMonthGrowth = dashboard.MonthOverMonthGrowthPercent;
                    recentTransactions = dashboard.RecentTransactions ?? [];
                }
            }
        }
        catch (Exception ex)
        {
            await JSRuntime.InvokeVoidAsync("alert", $"خطأ أثناء تحميل البيانات: {ex.Message}");
        }
        finally
        {
            loading = false;
        }
    }

    private void OnSearchInputChanged(ChangeEventArgs e)
    {
        searchQuery = e.Value?.ToString() ?? string.Empty;
        if (string.IsNullOrWhiteSpace(searchQuery))
        {
            searchResults.Clear();
            return;
        }

        searchResults = allTrainees
            .Where(t => t.Name.Contains(searchQuery, StringComparison.OrdinalIgnoreCase) || 
                        t.Phone.Contains(searchQuery, StringComparison.OrdinalIgnoreCase))
            .Take(5)
            .ToList();
    }

    private void ClearSearch()
    {
        searchQuery = string.Empty;
        searchResults.Clear();
    }

    private void SendWhatsAppReminder(ExpiringSubscriptionResult item)
    {
        var phone = GetTraineePhone(item.TraineeId);
        if (string.IsNullOrWhiteSpace(phone)) return;

        var cleanPhone = phone.Trim();
        if (cleanPhone.StartsWith("0"))
        {
            cleanPhone = "2" + cleanPhone;
        }

        var greeting = GetGreeting();
        var message = $"{greeting} {item.TraineeName}، نود تذكيرك بأن اشتراكك في الجيم سينتهي قريباً بتاريخ {item.EndDate:yyyy-MM-dd} (متبقي {item.RemainingDays} أيام). يسعدنا تشريفك لتجديد الاشتراك ومواصلة تمارينك! 🦾";
        var encodedMessage = Uri.EscapeDataString(message);
        var url = $"https://api.whatsapp.com/send?phone={cleanPhone}&text={encodedMessage}";

        JSRuntime.InvokeVoidAsync("open", url, "_blank");
    }

    private string GetTraineePhone(Guid traineeId)
    {
        var trainee = allTrainees.FirstOrDefault(t => t.TraineeId == traineeId);
        return trainee?.Phone ?? string.Empty;
    }

    private bool IsTraineeActive(GetAllTraineesResult t)
    {
        return t.CurrentSubscriptionEndDate.HasValue && t.CurrentSubscriptionEndDate.Value.Date >= DateTime.Today;
    }

    private string GetGreeting()
    {
        var hour = DateTime.Now.Hour;
        if (hour < 12) return "صباح الخير";
        return "مساء الخير";
    }

    private string GetPlanArabic(string? plan) => plan switch
    {
        "Basic" => "أساسي",
        "Cardio" => "كارديو",
        _ => plan ?? "غير محدد"
    };

    private string GetPeriodArabic(string? period) => period switch
    {
        "Daily" => "يومي",
        "Monthly" => "شهري",
        "SixMonths" => "نصف سنوي",
        "Yearly" => "سنوي",
        _ => period ?? "غير محدد"
    };

    private void NavigateTo(string path)
    {
        Navigation.NavigateTo(path);
    }

    private static string FormatMoney(decimal amount) => $"{amount:N2} ج.م";
}

