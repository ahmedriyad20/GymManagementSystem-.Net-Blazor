@page "/"
@attribute [Authorize]
@inject NavigationManager Navigation
@inject AuthenticationStateProvider AuthStateProvider
@inject ApiClient ApiClient
@inject IJSRuntime JSRuntime

<div class="dashboard-page animate__animated animate__fadeIn" dir="rtl">
    @if (loading)
    {
        <div class="d-flex flex-column align-items-center justify-content-center py-5">
            <div class="spinner-border text-primary mb-3" style="width: 3rem; height: 3rem;" role="status"></div>
            <div class="text-secondary fw-semibold">جاري تحميل لوحة التحكم الذكية...</div>
        </div>
    }
    else
    {
        <!-- Admin Profile & Welcome Section -->
        <div class="row g-3 mb-4">
            <div class="col-12 col-lg-8 d-flex flex-column justify-content-center">
                <div class="welcome-header">
                    <h1 class="display-6 fw-bold mb-1 text-dark">@GetGreeting()، يا كابتن @userName! 👋</h1>
                    <p class="text-muted mb-0">مرحباً بك مجدداً. إليك نظرة عامة شاملة على حالة الصالة اليوم - <span class="fw-semibold text-primary">@DateTime.Now.ToString("dd MMMM yyyy")</span></p>
                </div>
            </div>
            <div class="col-12 col-lg-4">
                <div class="card border-0 profile-card shadow-sm p-3 position-relative overflow-hidden h-100">
                    <div class="profile-glow"></div>
                    <div class="d-flex align-items-center gap-3">
                        <div class="avatar-circle">
                            @userName.Substring(0, Math.Min(2, userName.Length))
                        </div>
                        <div>
                            <h6 class="fw-bold mb-0 text-dark">@userName</h6>
                            <span class="badge bg-primary-subtle text-primary border border-primary-subtle rounded-pill mt-1 small">@userRole</span>
                            <div class="d-flex align-items-center gap-1 mt-1">
                                <span class="pulse-dot"></span>
                                <small class="text-success fw-semibold">حساب نشط</small>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Trainee Quick Search Input -->
        <div class="card border-0 shadow-sm search-card mb-4">
            <div class="card-body py-3">
                <div class="search-wrapper position-relative">
                    <div class="input-group">
                        <span class="input-group-text border-0 bg-transparent text-secondary"><i class="bi bi-search fs-5"></i></span>
                        <input type="text" 
                               class="form-control border-0 bg-transparent fs-5 py-2 dashboard-search-input" 
                               placeholder="ابحث عن متدرب بشكل سريع بالاسم أو رقم الهاتف..." 
                               @oninput="OnSearchInputChanged" 
                               @bind-value="searchQuery" />
                        @if (!string.IsNullOrWhiteSpace(searchQuery))
                        {
                            <button class="btn border-0 text-secondary bg-transparent" type="button" @onclick="ClearSearch">
                                <i class="bi bi-x-circle-fill fs-5"></i>
                            </button>
                        }
                    </div>

                    @if (searchResults.Count > 0)
                    {
                        <div class="search-results-dropdown shadow-lg animate__animated animate__fadeInUp">
                            <div class="dropdown-header d-flex justify-content-between align-items-center bg-light border-bottom px-3 py-2">
                                <span class="small fw-bold text-secondary">نتائج البحث الفوري (@searchResults.Count)</span>
                                <button class="btn btn-sm btn-link text-decoration-none p-0 text-danger" @onclick="ClearSearch">إغلاق</button>
                            </div>
                            <div class="list-group list-group-flush">
                                @foreach (var trainee in searchResults)
                                {
                                    <div class="list-group-item list-group-item-action d-flex justify-content-between align-items-center p-3" @onclick='() => NavigateTo($"/finance?search={trainee.Name}")' style="cursor: pointer;">
                                        <div class="d-flex align-items-center gap-3">
                                            <div class="search-avatar bg-primary-subtle text-primary fw-bold">
                                                @trainee.Name.Substring(0, Math.Min(1, trainee.Name.Length))
                                            </div>
                                            <div>
                                                <h6 class="fw-bold mb-0 text-dark">@trainee.Name</h6>
                                                <small class="text-muted d-block"><i class="bi bi-telephone ms-1"></i>@trainee.Phone</small>
                                                <small class="text-primary-emphasis d-block small">
                                                    باقة: @GetPlanArabic(trainee.CurrentSubscriptionPlan) - @GetPeriodArabic(trainee.CurrentSubscriptionPeriod)
                                                </small>
                                            </div>
                                        </div>
                                        <div class="d-flex align-items-center gap-2">
                                            @if (IsTraineeActive(trainee))
                                            {
                                                <span class="badge bg-success-subtle text-success border border-success-subtle px-2 py-1">نشط</span>
                                            }
                                            else
                                            {
                                                <span class="badge bg-danger-subtle text-danger border border-danger-subtle px-2 py-1">غير نشط</span>
                                            }
                                            <i class="bi bi-chevron-left text-secondary"></i>
                                        </div>
                                    </div>
                                }
                            </div>
                        </div>
                    }
                </div>
            </div>
        </div>

        <!-- Metric Row -->
        <div class="row g-3 mb-4">
            <!-- Active Trainees Card -->
            <div class="col-12 col-md-6 col-lg-3">
                <div class="card border-0 shadow-sm p-3 h-100 metric-card bg-active" @onclick='() => NavigateTo("/trainees")'>
                    <div class="d-flex justify-content-between align-items-center mb-2">
                        <span class="text-secondary fw-semibold">المتدربين النشطين</span>
                        <div class="metric-icon-bg bg-primary-subtle">
                            <i class="bi bi-people-fill text-primary fs-4"></i>
                        </div>
                    </div>
                    <h2 class="fw-bold text-dark display-6 mb-1">@activeTraineesCount.ToString("N0")</h2>
                    <div class="mt-2">
                        <div class="progress" style="height: 6px; background-color: rgba(0,0,0,0.05); border-radius: 3px;">
                            <div class="progress-bar bg-primary" role="progressbar" style="width: @(activePercentage)%" aria-valuenow="@activePercentage" aria-valuemin="0" aria-valuemax="100"></div>
                        </div>
                        <div class="d-flex justify-content-between mt-1">
                            <small class="text-muted">من إجمالي @totalTraineesCount متدرب</small>
                            <small class="fw-bold text-primary">@activePercentage%</small>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Net Earnings / Total Ladies Card -->
            @if (!isFemaleOnly)
            {
                <div class="col-12 col-md-6 col-lg-3">
                    <div class="card border-0 shadow-sm p-3 h-100 metric-card bg-earnings" @onclick='() => NavigateTo("/earnings")'>
                        <div class="d-flex justify-content-between align-items-center mb-2">
                            <span class="text-secondary fw-semibold">صافي أرباح الشهر</span>
                            <div class="metric-icon-bg bg-success-subtle">
                                <i class="bi bi-cash-coin text-success fs-4"></i>
                            </div>
                        </div>
                        <h2 class="fw-bold text-success display-6 mb-1">@FormatMoney(monthlyEarnings)</h2>
                        <div class="mt-1 d-flex flex-column gap-1">
                            <small class="text-muted d-block">إجمالي الإيرادات: <span class="fw-bold text-dark">@FormatMoney(monthlyEarningsBeforeExpenses)</span></small>
                            <div class="d-flex align-items-center gap-1">
                                @if (monthOverMonthGrowth >= 0)
                                {
                                    <i class="bi bi-arrow-up-right-circle-fill text-success fs-6"></i>
                                    <span class="small text-success fw-bold">@monthOverMonthGrowth.ToString("N1")% نمو عن الشهر الماضي</span>
                                }
                                else
                                {
                                    <i class="bi bi-arrow-down-right-circle-fill text-danger fs-6"></i>
                                    <span class="small text-danger fw-bold">@Math.Abs(monthOverMonthGrowth).ToString("N1")% انخفاض عن الشهر الماضي</span>
                                }
                            </div>
                        </div>
                    </div>
                </div>
            }
            else
            {
                <div class="col-12 col-md-6 col-lg-3">
                    <div class="card border-0 shadow-sm p-3 h-100 metric-card bg-female" @onclick='() => NavigateTo("/trainees")'>
                        <div class="d-flex justify-content-between align-items-center mb-2">
                            <span class="text-secondary fw-semibold">إجمالي المشتركات</span>
                            <div class="metric-icon-bg bg-info-subtle">
                                <i class="bi bi-gender-female text-info fs-4"></i>
                            </div>
                        </div>
                        <h2 class="fw-bold text-info display-6 mb-1">@totalTraineesCount.ToString("N0")</h2>
                        <div class="mt-2">
                            <div class="progress" style="height: 6px; background-color: rgba(0,0,0,0.05); border-radius: 3px;">
                                <div class="progress-bar bg-info" role="progressbar" style="width: @(activePercentage)%" aria-valuenow="@activePercentage" aria-valuemin="0" aria-valuemax="100"></div>
                            </div>
                            <div class="d-flex justify-content-between mt-1">
                                <small class="text-muted">مشتركة مسجلة بالكامل</small>
                                <small class="fw-bold text-info">@activeTraineesCount نشطة</small>
                            </div>
                        </div>
                    </div>
                </div>
            }

            <!-- Expiring Subscriptions Card -->
            <div class="col-12 col-md-6 col-lg-3">
                <div class="card border-0 shadow-sm p-3 h-100 metric-card bg-expiring" @onclick='() => NavigateTo("/reports/expiring")'>
                    <div class="d-flex justify-content-between align-items-center mb-2">
                        <span class="text-secondary fw-semibold">تنبيهات الانتهاء</span>
                        <div class="metric-icon-bg bg-warning-subtle">
                            <i class="bi bi-calendar2-week-fill text-warning fs-4 animate-bell"></i>
                        </div>
                    </div>
                    <h2 class="fw-bold text-warning display-6 mb-1">@expiringCount.ToString("N0")</h2>
                    <div class="mt-2">
                        <div class="d-flex align-items-center gap-1 py-1">
                            <span class="badge bg-warning-subtle text-warning border border-warning-subtle rounded px-2">ينتهي هذا الأسبوع</span>
                        </div>
                        <small class="text-muted">يتوجب تذكيرهم فوراً لتجديد الاشتراك</small>
                    </div>
                </div>
            </div>

            <!-- Outstanding Debt Card -->
            <div class="col-12 col-md-6 col-lg-3">
                <div class="card border-0 shadow-sm p-3 h-100 metric-card bg-debt" @onclick='() => NavigateTo("/finance")'>
                    <div class="d-flex justify-content-between align-items-center mb-2">
                        <span class="text-secondary fw-semibold">إجمالي المديونيات</span>
                        <div class="metric-icon-bg bg-danger-subtle">
                            <i class="bi bi-exclamation-octagon-fill text-danger fs-4"></i>
                        </div>
                    </div>
                    <h2 class="fw-bold text-danger display-6 mb-1">@FormatMoney(totalDebt)</h2>
                    <div class="mt-2">
                        <div class="d-flex justify-content-between align-items-center">
                            <small class="text-muted">مستحقة على <span class="fw-bold text-dark">@debtorsCount</span> متدربين</small>
                            <span class="badge bg-danger-subtle text-danger border border-danger-subtle rounded-pill px-2">معلقة</span>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Quick Actions & Dynamic Charts Panel -->
        <div class="row g-4 mb-4">
            <!-- Analytics and Charts Widget (Left) -->
            <div class="col-12 col-lg-8">
                <div class="card border-0 shadow-sm h-100">
                    <div class="card-body">
                        <div class="d-flex justify-content-between align-items-center mb-4">
                            <h5 class="fw-bold mb-0 text-dark"><i class="bi bi-bar-chart-line-fill text-primary ms-1"></i> إحصائيات الصالة وتحليل النشاط</h5>
                            <span class="badge bg-light text-dark border p-2 rounded-3 small">تحديث مباشر</span>
                        </div>

                        <div class="row g-3 align-items-center">
                            <!-- Circular SVG Active Ring -->
                            <div class="col-12 col-md-4 text-center">
                                <div class="chart-circle-container">
                                    <svg width="120" height="120" viewBox="0 0 120 120" class="progress-ring">
                                        <circle cx="60" cy="60" r="50" class="progress-ring-bg" stroke="#f1f3f5" stroke-width="8" fill="transparent" />
                                        <circle cx="60" cy="60" r="50" class="progress-ring-bar" stroke="var(--bs-primary)" stroke-width="8" fill="transparent"
                                                stroke-dasharray="314.16" stroke-dashoffset="@(strokeDashoffset.ToString("0.##", System.Globalization.CultureInfo.InvariantCulture))" stroke-linecap="round" />
                                        <text x="50%" y="50%" text-anchor="middle" dy=".3em" class="progress-ring-text text-dark" font-weight="bold" font-size="20">
                                            @activePercentage%
                                        </text>
                                    </svg>
                                    <div class="mt-2">
                                        <h6 class="fw-bold mb-0 text-dark small">معدل نشاط الأعضاء</h6>
                                        <small class="text-muted">نسبة المشتركين النشطين حالياً</small>
                                    </div>
                                </div>
                            </div>

                            <!-- Package Distribution Bar Chart -->
                            <div class="col-12 col-md-8">
                                <div class="packages-chart">
                                    <h6 class="fw-bold mb-3 text-secondary small"><i class="bi bi-tags ms-1"></i> توزيع المشتركين حسب الباقات النشطة</h6>
                                    <div class="d-flex flex-column gap-3">
                                        <div class="package-bar-item">
                                            <div class="d-flex justify-content-between mb-1 small text-dark">
                                                <span class="fw-bold">اشتراك شهري</span>
                                                <span class="text-muted">@monthlyCount متدرب</span>
                                            </div>
                                            <div class="progress" style="height: 6px; background-color: #f1f3f5; border-radius: 3px;">
                                                <div class="progress-bar bg-info rounded" style="width: @(monthlyCount * 100 / maxPeriodCount)%"></div>
                                            </div>
                                        </div>
                                        <div class="package-bar-item">
                                            <div class="d-flex justify-content-between mb-1 small text-dark">
                                                <span class="fw-bold">اشتراك نصف سنوي (6 أشهر)</span>
                                                <span class="text-muted">@sixMonthsCount متدرب</span>
                                            </div>
                                            <div class="progress" style="height: 6px; background-color: #f1f3f5; border-radius: 3px;">
                                                <div class="progress-bar bg-warning rounded" style="width: @(sixMonthsCount * 100 / maxPeriodCount)%"></div>
                                            </div>
                                        </div>
                                        <div class="package-bar-item">
                                            <div class="d-flex justify-content-between mb-1 small text-dark">
                                                <span class="fw-bold">اشتراك سنوي</span>
                                                <span class="text-muted">@yearlyCount متدرب</span>
                                            </div>
                                            <div class="progress" style="height: 6px; background-color: #f1f3f5; border-radius: 3px;">
                                                <div class="progress-bar bg-success rounded" style="width: @(yearlyCount * 100 / maxPeriodCount)%"></div>
                                            </div>
                                        </div>
                                        <div class="package-bar-item">
                                            <div class="d-flex justify-content-between mb-1 small text-dark">
                                                <span class="fw-bold">اشتراك يومي</span>
                                                <span class="text-muted">@dailyCount متدرب</span>
                                            </div>
                                            <div class="progress" style="height: 6px; background-color: #f1f3f5; border-radius: 3px;">
                                                <div class="progress-bar bg-secondary rounded" style="width: @(dailyCount * 100 / maxPeriodCount)%"></div>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <!-- Gender Distribution (Only for general admin) -->
                        @if (!isFemaleOnly)
                        {
                            <div class="gender-bar-wrapper border-top mt-4 pt-3">
                                <div class="d-flex justify-content-between mb-2 small text-dark fw-bold">
                                    <span>توزيع الجنسين في الصالة</span>
                                    <div class="d-flex gap-3">
                                        <span class="text-primary"><i class="bi bi-gender-male"></i> ذكور: @maleCount (@malePercentage%)</span>
                                        <span class="text-danger"><i class="bi bi-gender-female"></i> إناث: @femaleCount (@femalePercentage%)</span>
                                    </div>
                                </div>
                                <div class="progress" style="height: 12px; border-radius: 6px; overflow: hidden;">
                                    <div class="progress-bar bg-primary" role="progressbar" style="width: @(malePercentage)%" aria-valuenow="@malePercentage" aria-valuemin="0" aria-valuemax="100"></div>
                                    <div class="progress-bar bg-danger" role="progressbar" style="width: @(femalePercentage)%" aria-valuenow="@femalePercentage" aria-valuemin="0" aria-valuemax="100"></div>
                                </div>
                            </div>
                        }
                    </div>
                </div>
            </div>

            <!-- Quick Links Control Hub (Right) -->
            <div class="col-12 col-lg-4">
                <div class="card border-0 shadow-sm h-100">
                    <div class="card-body d-flex flex-column">
                        <h5 class="fw-bold mb-3 text-dark"><i class="bi bi-lightning-charge-fill text-warning ms-1"></i> روابط الوصول السريع</h5>
                        <div class="d-flex flex-column gap-3 flex-fill justify-content-center">
                            <button class="btn btn-outline-primary btn-lg py-3 text-start w-100 quick-link-btn" @onclick='() => NavigateTo("/trainees/register")'>
                                <div class="d-flex align-items-center gap-3">
                                    <div class="quick-icon-bg border-primary text-primary"><i class="bi bi-person-plus-fill fs-4"></i></div>
                                    <div>
                                        <h6 class="fw-bold mb-0 text-dark">تسجيل متدرب جديد</h6>
                                        <small class="text-muted">إضافة عضو وتدشين اشتراكه</small>
                                    </div>
                                </div>
                            </button>
                            
                            <button class="btn btn-outline-danger btn-lg py-3 text-start w-100 quick-link-btn" @onclick='() => NavigateTo("/expenses")'>
                                <div class="d-flex align-items-center gap-3">
                                    <div class="quick-icon-bg border-danger text-danger"><i class="bi bi-credit-card fs-4"></i></div>
                                    <div>
                                        <h6 class="fw-bold mb-0 text-dark">تسجيل المصاريف اليومية</h6>
                                        <small class="text-muted">توثيق فواتير المشتريات والالتزامات</small>
                                    </div>
                                </div>
                            </button>

                            <button class="btn btn-outline-success btn-lg py-3 text-start w-100 quick-link-btn" @onclick='() => NavigateTo("/subscription-prices")'>
                                <div class="d-flex align-items-center gap-3">
                                    <div class="quick-icon-bg border-success text-success"><i class="bi bi-tags-fill fs-4"></i></div>
                                    <div>
                                        <h6 class="fw-bold mb-0 text-dark">أسعار الاشتراكات وباقاتها</h6>
                                        <small class="text-muted">إدارة الأسعار والتسعير الأساسي</small>
                                    </div>
                                </div>
                            </button>

                            @if (!isFemaleOnly)
                            {
                                <button class="btn btn-outline-dark btn-lg py-3 text-start w-100 quick-link-btn" @onclick='() => NavigateTo("/transactions")'>
                                    <div class="d-flex align-items-center gap-3">
                                        <div class="quick-icon-bg border-dark text-dark"><i class="bi bi-receipt fs-4"></i></div>
                                        <div>
                                            <h6 class="fw-bold mb-0 text-dark">سجل المعاملات والواردات</h6>
                                            <small class="text-muted">مراقبة الأقساط والواردات النقدية</small>
                                        </div>
                                    </div>
                                </button>
                            }
                            else
                            {
                                <button class="btn btn-outline-info btn-lg py-3 text-start w-100 quick-link-btn" @onclick='() => NavigateTo("/finance")'>
                                    <div class="d-flex align-items-center gap-3">
                                        <div class="quick-icon-bg border-info text-info"><i class="bi bi-wallet2 fs-4"></i></div>
                                        <div>
                                            <h6 class="fw-bold mb-0 text-dark">قائمة المتدربات المديونات</h6>
                                            <small class="text-muted">متابعة الفواتير والأقساط المستحقة</small>
                                        </div>
                                    </div>
                                </button>
                            }
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Operational Multi-Tab Feed -->
        <div class="card border-0 shadow-sm mb-4">
            <div class="card-header bg-white border-0 pt-3 pb-0 px-3">
                <ul class="nav nav-tabs card-header-tabs border-0 gap-2" id="operationTabs" role="tablist">
                    @if (!isFemaleOnly)
                    {
                        <li class="nav-item" role="presentation">
                            <button class="nav-link border-0 rounded-3 fw-bold py-2 px-3 @(activeTab == "transactions" ? "active text-primary bg-primary-subtle" : "text-secondary bg-light")" 
                                    @onclick='() => activeTab = "transactions"' type="button">
                                <i class="bi bi-cash-stack ms-1"></i> آخر المعاملات المالية
                            </button>
                        </li>
                    }
                    <li class="nav-item" role="presentation">
                        <button class="nav-link border-0 rounded-3 fw-bold py-2 px-3 @(activeTab == "trainees" ? "active text-primary bg-primary-subtle" : "text-secondary bg-light")" 
                                @onclick='() => activeTab = "trainees"' type="button">
                            <i class="bi bi-people ms-1"></i> الأعضاء الجدد المسجلين
                        </button>
                    </li>
                    <li class="nav-item" role="presentation">
                        <button class="nav-link border-0 rounded-3 fw-bold py-2 px-3 @(activeTab == "expiring" ? "active text-primary bg-primary-subtle" : "text-secondary bg-light")" 
                                @onclick='() => activeTab = "expiring"' type="button">
                            <i class="bi bi-bell-fill ms-1 text-warning"></i> تنبيهات وتذكيرات انتهاء الاشتراكات
                        </button>
                    </li>
                </ul>
            </div>
            <div class="card-body p-3">
                <div class="tab-content" id="myTabContent">
                    <!-- Tab 1: Financial Transactions -->
                    @if (!isFemaleOnly && activeTab == "transactions")
                    {
                        <div class="table-responsive animate__animated animate__fadeIn">
                            <table class="table align-middle table-hover mb-0">
                                <thead class="table-light small">
                                    <tr>
                                        <th>التاريخ</th>
                                        <th>العضو / المستفيد</th>
                                        <th>الوصف</th>
                                        <th class="text-end">القيمة</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @if (recentTransactions.Count == 0)
                                    {
                                        <tr><td colspan="4" class="text-center py-4 text-secondary">لا توجد سجلات مالية حديثة للشهر الحالي.</td></tr>
                                    }
                                    else
                                    {
                                        @foreach (var tx in recentTransactions)
                                        {
                                            <tr>
                                                <td class="text-muted small">@tx.Date.ToString("yyyy-MM-dd HH:mm")</td>
                                                <td class="fw-semibold text-dark">@tx.Name</td>
                                                <td class="small">@tx.Description</td>
                                                <td class="text-end">
                                                    @if (tx.Amount >= 0)
                                                    {
                                                        <span class="fw-bold text-success">+@FormatMoney(tx.Amount)</span>
                                                    }
                                                    else
                                                    {
                                                        <span class="fw-bold text-danger">@FormatMoney(tx.Amount)</span>
                                                    }
                                                </td>
                                            </tr>
                                        }
                                    }
                                </tbody>
                            </table>
                        </div>
                    }

                    <!-- Tab 2: New Registrations -->
                    @if (activeTab == "trainees")
                    {
                        <div class="table-responsive animate__animated animate__fadeIn">
                            <table class="table align-middle table-hover mb-0">
                                <thead class="table-light small">
                                    <tr>
                                        <th>العضو الجديد</th>
                                        <th>الهاتف</th>
                                        <th>الباقة والاشتراك الفعال</th>
                                        <th>حالة الحساب</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @if (recentTrainees.Count == 0)
                                    {
                                        <tr><td colspan="4" class="text-center py-4 text-secondary">لا يوجد أعضاء مسجلين حديثاً في هذا النطاق.</td></tr>
                                    }
                                    else
                                    {
                                        @foreach (var trainee in recentTrainees)
                                        {
                                            <tr>
                                                <td class="fw-bold text-dark">
                                                    <div class="d-flex align-items-center gap-2">
                                                        <div class="search-avatar bg-primary-subtle text-primary fw-bold">
                                                            @trainee.Name.Substring(0, Math.Min(1, trainee.Name.Length))
                                                        </div>
                                                        <span>@trainee.Name</span>
                                                    </div>
                                                </td>
                                                <td>@trainee.Phone</td>
                                                <td class="small text-secondary">
                                                    باقة: @GetPlanArabic(trainee.CurrentSubscriptionPlan) - @GetPeriodArabic(trainee.CurrentSubscriptionPeriod)
                                                </td>
                                                <td>
                                                    @if (IsTraineeActive(trainee))
                                                    {
                                                        <span class="badge bg-success-subtle text-success border border-success-subtle px-2 py-1">نشط</span>
                                                    }
                                                    else
                                                    {
                                                        <span class="badge bg-danger-subtle text-danger border border-danger-subtle px-2 py-1">غير نشط</span>
                                                    }
                                                </td>
                                            </tr>
                                        }
                                    }
                                </tbody>
                            </table>
                        </div>
                    }

                    <!-- Tab 3: Expiring & WhatsApp Reminders -->
                    @if (activeTab == "expiring")
                    {
                        <div class="table-responsive animate__animated animate__fadeIn">
                            <table class="table align-middle table-hover mb-0">
                                <thead class="table-light small">
                                    <tr>
                                        <th>اسم المتدرب</th>
                                        <th>الهاتف</th>
                                        <th>تاريخ انتهاء الاشتراك</th>
                                        <th>الوقت المتبقي</th>
                                        <th class="text-center">إجراء التذكير</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @if (expiringSubList.Count == 0)
                                    {
                                        <tr><td colspan="5" class="text-center py-4 text-secondary">لا توجد اشتراكات منتهية قريباً هذا الأسبوع. 🎉</td></tr>
                                    }
                                    else
                                    {
                                        @foreach (var item in expiringSubList.Take(10))
                                        {
                                            var phone = GetTraineePhone(item.TraineeId);
                                            <tr>
                                                <td class="fw-bold text-dark">@item.TraineeName</td>
                                                <td>@phone</td>
                                                <td>@item.EndDate.ToString("yyyy-MM-dd")</td>
                                                <td>
                                                    <span class="badge bg-warning-subtle text-warning border border-warning-subtle px-2 py-1">
                                                        يتبقى @item.RemainingDays يوم
                                                    </span>
                                                </td>
                                                <td class="text-center">
                                                    @if (!string.IsNullOrWhiteSpace(phone))
                                                    {
                                                        <button class="btn btn-success btn-sm px-3 rounded-pill fw-bold d-inline-flex align-items-center gap-2 whatsapp-btn" 
                                                                @onclick="() => SendWhatsAppReminder(item)">
                                                            <i class="bi bi-whatsapp"></i> تذكير بالواتساب
                                                        </button>
                                                    }
                                                    else
                                                    {
                                                        <span class="small text-muted">لا يوجد هاتف</span>
                                                    }
                                                </td>
                                            </tr>
                                        }
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                </div>
            </div>
        </div>
    }
</div>

<style>
