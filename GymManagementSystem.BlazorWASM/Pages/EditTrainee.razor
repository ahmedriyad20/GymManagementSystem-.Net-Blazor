@page "/trainees/{TraineeId:guid}/edit"
@attribute [Authorize]
@inject ApiClient ApiClient
@inject NavigationManager Navigation
@using System.ComponentModel.DataAnnotations

<div class="register-page">
    <div class="register-header mb-4">
        <h1 class="display-6 fw-bold mb-1">تعديل بيانات المتدرب</h1>
        <p class="text-secondary mb-0">تحديث بيانات العضو وإدارة الاشتراك من نفس الشاشة</p>
    </div>

    @if (loading)
    {
        <div class="card border-0 shadow-sm register-section">
            <div class="card-body p-4 text-secondary">جاري تحميل البيانات...</div>
        </div>
    }
    else
    {
        <EditForm Model="form" OnValidSubmit="SaveAsync">
            <DataAnnotationsValidator />

            <section class="register-section card border-0 shadow-sm mb-4">
                <div class="card-body p-4">
                    <h3 class="section-title">المعلومات الشخصية</h3>

                    <div class="row g-4 align-items-stretch">
                        <div class="col-lg-8">
                            <div class="row g-3">
                                <div class="col-12">
                                    <label class="form-label">الاسم الكامل</label>
                                    <InputText class="form-control form-control-lg" @bind-Value="form.Name" placeholder="مثال: أحمد محمد" />
                                </div>
                                <div class="col-md-6">
                                    <label class="form-label">رقم الهاتف</label>
                                    <InputText class="form-control form-control-lg" @bind-Value="form.Phone" placeholder="+966 50 000 0000" />
                                </div>
                                <div class="col-md-6">
                                    <label class="form-label">الجنس</label>
                                    <InputSelect class="form-select form-select-lg" @bind-Value="form.Gender">
                                        <option value="@enGender.Male">ذكر</option>
                                        <option value="@enGender.Female">أنثى</option>
                                    </InputSelect>
                                </div>
                                <div class="col-md-6">
                                    <label class="form-label">تاريخ الميلاد</label>
                                    <InputDate class="form-control form-control-lg" @bind-Value="form.DateOfBirth" />
                                </div>
                                <div class="col-md-6">
                                    <label class="form-label">حالة العضوية</label>
                                    <div class="form-check form-switch mt-2">
                                        <InputCheckbox class="form-check-input" @bind-Value="form.IsActive" />
                                        <label class="form-check-label me-2">عضو نشط</label>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <div class="col-lg-4">
                            <label class="photo-dropzone h-100" for="photoInput">
                                <i class="bi bi-camera-fill fs-1"></i>
                                <h6 class="mt-3 mb-1">تحديث الصورة</h6>
                                <p class="mb-0 text-secondary">JPG أو PNG، بحد أقصى 2 ميجابايت</p>
                                @if (!string.IsNullOrWhiteSpace(selectedPhotoName))
                                {
                                    <small class="text-success d-block mt-2">@selectedPhotoName</small>
                                }
                                else if (!string.IsNullOrWhiteSpace(currentPhotoPath))
                                {
                                    <img src="@GetPhotoUrl(currentPhotoPath)" alt="@form.Name" class="trainee-photo-large mt-2" />
                                }
                                else
                                {
                                    <small class="text-muted d-block mt-2">اضغط لاختيار الصورة</small>
                                }
                            </label>
                            <InputFile id="photoInput" class="d-none" OnChange="OnPhotoChanged" accept=".jpg,.jpeg,.png,image/jpeg,image/png" />
                        </div>
                    </div>
                </div>
            </section>

            <section class="register-section card border-0 shadow-sm mb-4">
                <div class="card-body p-4">
                    <h3 class="section-title">إدارة الاشتراك</h3>

                    @if (!hasAnySubscription)
                    {
                        <div class="alert alert-info">هذا المتدرب لم يسبق له أي اشتراك.</div>
                        <div class="form-check form-switch mb-3">
                            <InputCheckbox class="form-check-input" @bind-Value="createSubscriptionForNoHistory" />
                            <label class="form-check-label me-2">إنشاء اشتراك الآن</label>
                        </div>
                    }
                    else if (activeSubscription is null)
                    {
                        <div class="alert alert-warning">لا يوجد اشتراك نشط حالياً لهذا المتدرب.</div>
                        <div class="form-check form-switch mb-3">
                            <InputCheckbox class="form-check-input" @bind-Value="createSubscriptionForInactive" />
                            <label class="form-check-label me-2">إنشاء اشتراك جديد</label>
                        </div>
                    }
                    else
                    {
                        <div class="alert alert-success">يوجد اشتراك نشط حالياً ويمكنك تحديثه أو تعطيله.</div>
                        <div class="d-flex flex-wrap gap-3 mb-3">
                            <div class="form-check">
                                <input class="form-check-input" type="radio" name="subscriptionAction" id="actionNone" value="None" checked='@(subscriptionAction == "None")' @onchange='() => SetSubscriptionAction("None")' />
                                <label class="form-check-label" for="actionNone">بدون تعديل الاشتراك</label>
                            </div>
                            <div class="form-check">
                                <input class="form-check-input" type="radio" name="subscriptionAction" id="actionUpdate" value="Update" checked='@(subscriptionAction == "Update")' @onchange='() => SetSubscriptionAction("Update")' />
                                <label class="form-check-label" for="actionUpdate">تحديث الاشتراك</label>
                            </div>
                            <div class="form-check">
                                <input class="form-check-input" type="radio" name="subscriptionAction" id="actionDeactivate" value="Deactivate" checked='@(subscriptionAction == "Deactivate")' @onchange='() => SetSubscriptionAction("Deactivate")' />
                                <label class="form-check-label text-danger" for="actionDeactivate">تعطيل الاشتراك الحالي</label>
                            </div>
                        </div>
                    }

                    @if (ShouldShowSubscriptionInputs())
                    {
                        <div class="row g-3">
                            <div class="col-md-3">
                                <label class="form-label">خطة الاشتراك</label>
                                <InputSelect class="form-select form-select-lg" @bind-Value="form.SubscriptionPlan" @bind-Value:after="OnSubscriptionDetailsChanged">
                                    <option value="@enSubscriptionPlan.Basic">Basic (أساسي)</option>
                                    <option value="@enSubscriptionPlan.Cardio">Cardio (كارديو)</option>
                                </InputSelect>
                            </div>
                            <div class="col-md-3">
                                <label class="form-label">المدة</label>
                                <InputSelect class="form-select form-select-lg" @bind-Value="form.SubscriptionPeriod" @bind-Value:after="OnSubscriptionDetailsChanged">
                                    <option value="@enSubscriptionPeriod.Daily">Daily (يومي)</option>
                                    <option value="@enSubscriptionPeriod.Monthly">Monthly (شهري)</option>
                                    <option value="@enSubscriptionPeriod.SixMonths">6 Months (6 أشهر)</option>
                                    <option value="@enSubscriptionPeriod.Yearly">Yearly (سنوي)</option>
                                </InputSelect>
                            </div>
                            <div class="col-md-3">
                                <label class="form-label">السعر (ج.م)</label>
                                <InputNumber class="form-control form-control-lg" @bind-Value="form.SubscriptionPrice" min="0.01" step="0.01" />
                                <ValidationMessage For="() => form.SubscriptionPrice" />
                            </div>
                            <div class="col-md-3">
                                <label class="form-label">تاريخ بداية الاشتراك</label>
                                <InputDate class="form-control form-control-lg" @bind-Value="form.SubscriptionStartDate" />
                            </div>
                        </div>

                        <div class="row g-3 mt-1">
                            <div class="col-md-6">
                                <label class="form-label">المبلغ المدفوع</label>
                                <InputNumber class="form-control form-control-lg" @bind-Value="form.PaidAmount" />
                            </div>
                        </div>
                    }
                </div>
            </section>

            @if (!string.IsNullOrWhiteSpace(message))
            {
                <div class="alert @(message.Contains("بنجاح") ? "alert-success" : "alert-danger")">@message</div>
            }

            <div class="d-flex gap-2 justify-content-start">
                <button class="btn btn-primary btn-lg" type="submit" disabled="@saving">
                    <i class="bi bi-check2-circle ms-1"></i>
                    @((saving ? "جاري الحفظ..." : "حفظ التعديلات"))
                </button>
                <button class="btn btn-outline-secondary btn-lg" type="button" @onclick='() => Navigation.NavigateTo("/trainees")'>إلغاء</button>
            </div>
        </EditForm>
    }
</div>

@if (isDeactivateConfirmOpen)
{
    <div class="finance-modal-backdrop" @onclick="CloseDeactivateConfirmation"></div>
    <div class="finance-modal card border-0 shadow">
        <div class="card-header bg-white d-flex justify-content-between align-items-center">
            <h5 class="mb-0 text-danger">تأكيد تعطيل الاشتراك</h5>
            <button class="btn btn-sm btn-light" type="button" @onclick="CloseDeactivateConfirmation">
                <i class="bi bi-x-lg"></i>
            </button>
        </div>
        <div class="card-body">
            <p class="mb-2">سيتم تعطيل الاشتراك النشط الحالي لهذا المتدرب.</p>
            <p class="mb-0 text-secondary">يمكنك إنشاء اشتراك جديد لاحقاً من نفس الشاشة إذا احتجت ذلك.</p>
        </div>
        <div class="card-footer bg-white d-flex justify-content-end gap-2">
            <button class="btn btn-outline-secondary" type="button" @onclick="CloseDeactivateConfirmation" disabled="@saving">إلغاء</button>
            <button class="btn btn-danger" type="button" @onclick="ConfirmDeactivateAsync" disabled="@saving">
                @(saving ? "جاري الحفظ..." : "تأكيد التعطيل")
            </button>
        </div>
    </div>
}

@code {
    [Parameter] public Guid TraineeId { get; set; }

    private EditFormModel form = new();
    private List<GetAllSubscriptionPricesResult> prices = [];
    private bool loading = true;
    private bool saving;
    private string? message;
    private IBrowserFile? selectedPhoto;
    private string? selectedPhotoName;
    private string? currentPhotoPath;

    private TraineeSubscriptionView? activeSubscription;
    private TraineeSubscriptionView? latestSubscription;
    private bool hasAnySubscription;
    private bool createSubscriptionForNoHistory;
    private bool createSubscriptionForInactive;
    private string subscriptionAction = "None";
    private bool isDeactivateConfirmOpen;
    private bool deactivateConfirmed;

    protected override async Task OnParametersSetAsync()
    {
        loading = true;
        message = null;

        prices = await ApiClient.GetSubscriptionPricesAsync();
        var trainee = await ApiClient.GetTraineeAsync(TraineeId);
        if (trainee is null)
        {
            message = "لم يتم العثور على المتدرب.";
            loading = false;
            return;
        }

        form = new EditFormModel
        {
            Name = trainee.Name,
            Phone = trainee.Phone,
            DateOfBirth = trainee.DateOfBirth,
            Gender = trainee.Gender.Equals("Female", StringComparison.OrdinalIgnoreCase) ? enGender.Female : enGender.Male,
            IsActive = trainee.IsActive
        };

        hasAnySubscription = trainee.Subscriptions.Any();
        latestSubscription = trainee.Subscriptions.OrderByDescending(s => s.EndDate).FirstOrDefault();
        activeSubscription = trainee.Subscriptions
            .Where(s => s.StartDate.Date <= DateTime.Today && s.EndDate.Date >= DateTime.Today)
            .OrderByDescending(s => s.EndDate)
            .FirstOrDefault();

        if (activeSubscription is not null)
        {
            form.SubscriptionPlan = ParsePlan(activeSubscription.SubscriptionPlan);
            form.SubscriptionPeriod = ParsePeriod(activeSubscription.SubscriptionPeriod);
            form.SubscriptionStartDate = activeSubscription.StartDate;
            form.SubscriptionPrice = activeSubscription.SubscriptionPrice;
            form.PaidAmount = activeSubscription.PaidAmount;
            subscriptionAction = "Update";
        }
        else if (latestSubscription is not null)
        {
            form.SubscriptionPlan = ParsePlan(latestSubscription.SubscriptionPlan);
            form.SubscriptionPeriod = ParsePeriod(latestSubscription.SubscriptionPeriod);
            form.SubscriptionStartDate = DateTime.Today;
            form.SubscriptionPrice = ResolveTotalPrice();
            form.PaidAmount = 0;
            subscriptionAction = "None";
        }
        else
        {
            form.SubscriptionPlan = enSubscriptionPlan.Basic;
            form.SubscriptionPeriod = enSubscriptionPeriod.Monthly;
            form.SubscriptionStartDate = DateTime.Today;
            form.SubscriptionPrice = ResolveTotalPrice();
            form.PaidAmount = 0;
        }

        currentPhotoPath = trainee.PhotoPath;
        selectedPhoto = null;
        selectedPhotoName = null;
        loading = false;
    }

    private bool ShouldShowSubscriptionInputs()
    {
        if (!hasAnySubscription)
        {
            return createSubscriptionForNoHistory;
        }

        if (activeSubscription is null)
        {
            return createSubscriptionForInactive;
        }

        return subscriptionAction == "Update";
    }

    private async Task SaveAsync()
    {
        if (activeSubscription is not null && subscriptionAction == "Deactivate" && !deactivateConfirmed)
        {
            isDeactivateConfirmOpen = true;
            return;
        }

        saving = true;
        message = null;

        try
        {
            await ApiClient.UpdateTraineeAsync(TraineeId, new UpdateTraineeCommand
            {
                Name = form.Name,
                Phone = form.Phone,
                DateOfBirth = form.DateOfBirth,
                Gender = form.Gender,
                IsActive = form.IsActive
            }, selectedPhoto);

            if (!hasAnySubscription)
            {
                if (createSubscriptionForNoHistory)
                {
                    await CreateSubscriptionAsync();
                }
            }
            else if (activeSubscription is null)
            {
                if (createSubscriptionForInactive)
                {
                    await CreateSubscriptionAsync();
                }
            }
            else
            {
                if (subscriptionAction == "Update")
                {
                    await ApiClient.UpdateSubscriptionAsync(activeSubscription.SubscriptionId, new UpdateSubscriptionCommand
                    {
                        SubscriptionPlan = form.SubscriptionPlan,
                        SubscriptionPeriod = form.SubscriptionPeriod,
                        SubscriptionPrice = form.SubscriptionPrice,
                        PaidAmount = form.PaidAmount,
                        StartDate = form.SubscriptionStartDate
                    });
                }
                else if (subscriptionAction == "Deactivate")
                {
                    await ApiClient.DeactivateActiveSubscriptionAsync(TraineeId);
                }
            }

            message = "تم تحديث بيانات المتدرب بنجاح.";
            Navigation.NavigateTo($"/trainees/{TraineeId}");
        }
        catch (Exception ex)
        {
            message = ex.Message;
        }
        finally
        {
            deactivateConfirmed = false;
            saving = false;
        }
    }

    private void SetSubscriptionAction(string action)
    {
        subscriptionAction = action;
        deactivateConfirmed = false;
        isDeactivateConfirmOpen = false;
    }

    private void CloseDeactivateConfirmation()
    {
        isDeactivateConfirmOpen = false;
        deactivateConfirmed = false;
    }

    private async Task ConfirmDeactivateAsync()
    {
        deactivateConfirmed = true;
        isDeactivateConfirmOpen = false;
        await SaveAsync();
    }

    private async Task CreateSubscriptionAsync()
    {
        await ApiClient.CreateSubscriptionAsync(new CreateSubscriptionCommand
        {
            TraineeId = TraineeId,
            SubscriptionPlan = form.SubscriptionPlan,
            SubscriptionPeriod = form.SubscriptionPeriod,
            SubscriptionPrice = form.SubscriptionPrice,
            PaidAmount = form.PaidAmount,
            StartDate = form.SubscriptionStartDate
        });
    }

    private void OnSubscriptionDetailsChanged()
    {
        form.SubscriptionPrice = ResolveTotalPrice();
    }

    private decimal ResolveTotalPrice()
    {
        var price = prices.FirstOrDefault(x => x.SubscriptionPlan == form.SubscriptionPlan.ToString() && x.SubscriptionPeriod == form.SubscriptionPeriod.ToString());
        return price?.Price ?? 0m;
    }

    private static enSubscriptionPlan ParsePlan(string plan)
    {
        return Enum.TryParse<enSubscriptionPlan>(plan, true, out var parsed) ? parsed : enSubscriptionPlan.Basic;
    }

    private static enSubscriptionPeriod ParsePeriod(string period)
    {
        return Enum.TryParse<enSubscriptionPeriod>(period, true, out var parsed) ? parsed : enSubscriptionPeriod.Monthly;
    }

    private void OnPhotoChanged(InputFileChangeEventArgs e)
    {
        message = null;
        selectedPhoto = null;
        selectedPhotoName = null;

        var file = e.File;
        if (file is null)
        {
            return;
        }

        var ext = System.IO.Path.GetExtension(file.Name).ToLowerInvariant();
        var isAllowedExt = ext is ".jpg" or ".jpeg" or ".png";
        if (!isAllowedExt)
        {
            message = "صيغة الصورة غير مدعومة. استخدم JPG أو PNG.";
            return;
        }

        if (file.Size > 2 * 1024 * 1024)
        {
            message = "حجم الصورة أكبر من 2 ميجابايت.";
            return;
        }

        selectedPhoto = file;
        selectedPhotoName = file.Name;
    }

    private string GetPhotoUrl(string photoPath)
    {
        if (string.IsNullOrWhiteSpace(photoPath)) return string.Empty;

        if (Navigation.Uri.StartsWith("https://", StringComparison.OrdinalIgnoreCase) &&
            photoPath.StartsWith("http://localhost:5053/", StringComparison.OrdinalIgnoreCase))
        {
            return photoPath.Replace("http://localhost:5053/", "https://localhost:7195/");
        }

        return photoPath;
    }

    private class EditFormModel
    {
        [Required(ErrorMessage = "الاسم مطلوب.")]
        public string Name { get; set; } = string.Empty;

        [Required(ErrorMessage = "رقم الهاتف مطلوب.")]
        public string Phone { get; set; } = string.Empty;

        public DateTime DateOfBirth { get; set; } = DateTime.Today.AddYears(-20);
        public enGender Gender { get; set; } = enGender.Male;
        public bool IsActive { get; set; } = true;
        public enSubscriptionPlan SubscriptionPlan { get; set; } = enSubscriptionPlan.Basic;
        public enSubscriptionPeriod SubscriptionPeriod { get; set; } = enSubscriptionPeriod.Monthly;
        public DateTime SubscriptionStartDate { get; set; } = DateTime.Today;

        [Range(0, double.MaxValue, ErrorMessage = "المبلغ المدفوع يجب أن يكون 0 أو أكثر.")]
        public decimal PaidAmount { get; set; }

        [Required(ErrorMessage = "سعر الاشتراك مطلوب.")]
        [Range(0.01, double.MaxValue, ErrorMessage = "يجب أن يكون سعر الاشتراك أكبر من 0.")]
        public decimal SubscriptionPrice { get; set; }
    }
}
